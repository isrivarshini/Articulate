# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/articulate

# JWT Auth
SECRET_KEY=change-me-to-a-real-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Whisper
WHISPER_MODEL=base

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
